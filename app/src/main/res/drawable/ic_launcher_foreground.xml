<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Subtle shadow/glow under home structure -->
  <path
      android:pathData="M33,76 h42 a3,3 0 0,1 3,3 v0 a3,3 0 0,1 -3,3 h-42 a3,3 0 0,1 -3,-3 v0 a3,3 0 0,1 3,-3 Z"
      android:fillAlpha="0.25"
      android:fillColor="#000000" />

  <!-- Main House Body with subtle rounding -->
  <path
      android:pathData="M37,48 L54,32 L71,48 L71,73 C71,75.2 69.2,77 67,77 L41,77 C38.8,77 37,75.2 37,73 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="54"
          android:startY="32"
          android:endX="54"
          android:endY="77"
          android:type="linear">
        <item android:offset="0.0" android:color="#4F46E5"/>
        <item android:offset="1.0" android:color="#1E1B4B"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Left Roof Wing Facet (Highlight) -->
  <path
      android:pathData="M54,28 L30,47.5 C29.2,48.2 29.8,49.5 30.8,49.5 L34,49.5 L54,33 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="30"
          android:startY="49"
          android:endX="54"
          android:endY="28"
          android:type="linear">
        <item android:offset="0.0" android:color="#06B6D4"/>
        <item android:offset="1.0" android:color="#38BDF8"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Right Roof Wing Facet (Vibrant Violet / Indigo) -->
  <path
      android:pathData="M54,28 L78,47.5 C78.8,48.2 78.2,49.5 77.2,49.5 L74,49.5 L54,33 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="54"
          android:startY="28"
          android:endX="78"
          android:endY="49"
          android:type="linear">
        <item android:offset="0.0" android:color="#818CF8"/>
        <item android:offset="1.0" android:color="#A855F7"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Chimney / Port indicator -->
  <path
      android:pathData="M65,37 L65,32 C65,31.2 65.7,30.5 66.5,30.5 L69,30.5 C69.8,30.5 70.5,31.2 70.5,32 L70.5,41.5 Z"
      android:fillColor="#6366F1" />

  <!-- Portal Entrance / Portal Door Arch -->
  <path
      android:pathData="M48,77 L48,63 C48,59.7 50.7,57 54,57 C57.3,57 60,59.7 60,63 L60,77 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="54"
          android:startY="57"
          android:endX="54"
          android:endY="77"
          android:type="linear">
        <item android:offset="0.0" android:color="#06B6D4"/>
        <item android:offset="0.6" android:color="#38BDF8"/>
        <item android:offset="1.0" android:color="#FFFFFF"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Glowing Core Star / Launcher Spark in the portal doorway -->
  <path
      android:pathData="M54,61 L55.2,64.5 L58.7,65.7 L55.2,66.9 L54,70.4 L52.8,66.9 L49.3,65.7 L52.8,64.5 Z"
      android:fillColor="#FFFFFF" />

  <!-- Dynamic Orbital Ring around Portal (Symbolizing 'Any' Launcher Gateway) -->
  <path
      android:pathData="M38,62 C38,55 70,52 70,62 C70,68 45,71 39,66"
      android:strokeWidth="1.6"
      android:strokeAlpha="0.75"
      android:strokeColor="#22D3EE"
      android:strokeLineCap="round"/>
</vector>
